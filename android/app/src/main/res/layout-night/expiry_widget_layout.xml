<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="12dp"
    android:background="@drawable/widget_background">

    <ImageView
        android:id="@+id/widget_logo"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_alignParentStart="true"
        android:layout_alignParentTop="true"
        android:src="@mipmap/ic_launcher"
        android:contentDescription="GlowMatch Logo" />

    <TextView
        android:id="@+id/widget_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_toEndOf="@id/widget_logo"
        android:layout_marginStart="6dp"
        android:layout_alignBottom="@id/widget_logo"
        android:text="GLOWMATCH POUCH ALERT"
        android:textStyle="bold"
        android:textColor="#E5A99E"
        android:textSize="10sp"
        android:letterSpacing="0.05" />

    <TextView
        android:id="@+id/widget_product_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/widget_logo"
        android:layout_marginTop="8dp"
        android:text="Semua produk aman ✨"
        android:textColor="#F8FAFC"
        android:textStyle="bold"
        android:textSize="13sp"
        android:maxLines="1"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/widget_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/widget_product_name"
        android:layout_marginTop="2dp"
        android:text="Tidak ada produk yang mendekati PAO."
        android:textColor="#94A3B8"
        android:textSize="10sp"
        android:maxLines="1"
        android:ellipsize="end" />
</RelativeLayout>
