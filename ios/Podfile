# Uncomment this line to define a global platform for your project
platform :ios, '15.5'

# CocoaPods analytics sends network stats so feel free to disable it.
# disable_cocoapods_analytics!

# Load Flutter helper script safely, falling back to FLUTTER_ROOT if not generated yet
flutter_root = ENV['FLUTTER_ROOT']
podhelper_path = File.expand_path(File.join('Flutter', 'podhelper.rb'), __dir__)

if File.exist?(podhelper_path)
  require podhelper_path
elsif flutter_root
  require File.expand_path('packages/flutter_tools/bin/podhelper.rb', flutter_root)
else
  raise "Flutter SDK not found. Please define FLUTTER_ROOT environment variable."
end

target 'Runner' do
  use_frameworks!
  use_modular_headers!

  flutter_install_all_ios_pods File.dirname(File.expand_path(__FILE__))

  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
    target.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.5'
    end
  end
end
